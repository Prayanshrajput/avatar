    "spike:tripo": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/spike-tripo.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "spike:image": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/spike-image.ts",
    "optimize:glb": "tsx scripts/optimize-glb.ts",
    "build:character": "tsx scripts/build-character.ts",
    "verify:character": "tsx scripts/verify-character.ts",
    "phone": "next build && next start -H 0.0.0.0",
